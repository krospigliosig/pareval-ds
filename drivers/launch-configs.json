{
  "serial": {
    "format": "{exec_path} {args}",
    "params": [{}]
  },
  "omp": {
    "format": "env OMP_NUM_THREADS={num_threads} {exec_path} {args}",
    "params": [
      {"num_threads": 1},
      {"num_threads": 2},
      {"num_threads": 4},
      {"num_threads": 8},
      {"num_threads": 16}
    ]
  },
  "mpi": {
    "format": "mpirun -np {num_procs} {exec_path} {args}",
    "params": [
      {"num_procs": 1},
      {"num_procs": 2},
      {"num_procs": 4},
      {"num_procs": 8}
    ]
  },
  "mpi+omp": {
    "format": "mpirun -np {num_procs} OMP_NUM_THREADS={num_threads} {exec_path} {args}",
    "params": [
      {"num_procs": 1, "num_threads": 1},
      {"num_procs": 1, "num_threads": 2},
      {"num_procs": 1, "num_threads": 4},
      {"num_procs": 2, "num_threads": 2}
    ]
  },
  "kokkos": {
    "format": "OMP_NUM_THREADS={num_threads} {exec_path} {args} --kokkos-num-threads={num_threads}",
    "params": [
      {"num_threads": 1},
      {"num_threads": 2},
      {"num_threads": 4},
      {"num_threads": 8}
    ]
  },
  "cuda": {
    "format": "{exec_path} {args}",
    "params": [{}]
  },
  "hip": {
    "format": "{exec_path} {args}",
    "params": [{}]
  }
}
